{
  "name": "@slate-orm/client",
  "version": "0.1.0",
  "description": "A TypeScript client for a slate head node",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlerops/slate-orm.git",
    "directory": "clients/typescript"
  },
  "homepage": "https://github.com/howlerops/slate-orm/tree/main/clients/typescript",
  "bugs": {
    "url": "https://github.com/howlerops/slate-orm/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "default": "./dist/edge.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.json && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "protobufjs-cli": "1.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
